{
  "name": "gestor-aramis",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:shared": "vite --mode shared --host 127.0.0.1 --port 5174",
    "build": "tsc -b && vite build",
    "build:shared": "tsc -b && vite build --mode shared",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:shared": "playwright test --config playwright.shared.config.ts",
    "worker:dev": "wrangler dev --ip 127.0.0.1 --port 8787",
    "worker:check": "wrangler deploy --dry-run --outdir work/worker-build",
    "pages:check": "wrangler pages functions build --outdir work/pages-build",
    "pages:dev": "wrangler pages dev dist --ip 127.0.0.1 --port 8788",
    "pages:prepare": "node scripts/prepare-pages.mjs",
    "pages:preview": "wrangler pages dev --cwd work/pages-deploy --ip 127.0.0.1 --port 8788",
    "pages:smoke": "node scripts/smoke-pages.mjs",
    "pages:deploy": "npm run pages:prepare && wrangler pages deploy --cwd work/pages-deploy --project-name gestor-aramis --branch main"
  },
  "dependencies": {
    "@fontsource/dm-serif-display": "5.3.0",
    "@fontsource/lato": "5.3.0",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-slot": "1.3.3",
    "@radix-ui/react-tabs": "1.1.21",
    "@supabase/supabase-js": "2.115.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.41.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "3.6.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.4.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "5.0.0",
    "wrangler": "4.129.0"
  }
}
